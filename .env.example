# Copy this file to .env. Never commit .env.
# Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key

PORT=3000

# Docker Compose uses these to create the database and its app connection URL.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=tasks

# Optional: host-run Postgres. Leave unset to use the local SQLite fallback.
# Compose constructs its own DATABASE_URL with hostname "db".
# DATABASE_URL=postgresql://taskflow:password@127.0.0.1:5432/tasks
