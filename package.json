{
  "name": "taskflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "Postgres-backed task API with a lightweight Docker Compose stack",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "verify:persistence": "node --env-file-if-exists=.env scripts/verify-persistence.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
